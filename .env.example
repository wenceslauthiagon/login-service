# Application
APP_PORT=3000
HOST=0.0.0.0

# JWT
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=1h

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_SECURE=false
EMAIL_SERVICE=gmail
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="no-reply@example.com"

# Maildev credentials (local dev inbox)
MAILDEV_INCOMING_USER=maildev
MAILDEV_INCOMING_PASS=maildev

# Database (Prisma)
# Postgres (used by docker-compose)
# Set these values in your local `.env` (do not commit secrets).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=login_db

# Prisma connection string (Prisma will read DATABASE_URL directly).
# You can leave DATABASE_URL commented and construct it locally from the POSTGRES_* values if preferred.
# Example for host-based runs (PowerShell):
# $env:DATABASE_URL = "postgresql://$env:POSTGRES_USER:$env:POSTGRES_PASSWORD@localhost:5432/$env:POSTGRES_DB?schema=public"
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/login_db?schema=public"

# Other
NODE_ENV=development
BCRYPT_SALT_ROUNDS=10
RESET_TOKEN_EXPIRATION_MINUTES=60
FRONTEND_URL=http://localhost:3001
ENABLE_SWAGGER=true
